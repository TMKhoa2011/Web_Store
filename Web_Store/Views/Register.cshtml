@{
    ViewData["Title"] = "Register";
}
@model Web_Store.Models.RegisterViewModel

<h2>Đăng ký tài khoản mới</h2>

<div class="content_section" style="width: 50%; margin: 0 auto; padding: 20px;">
    <form asp-action="Register" method="post">

        <!-- Hiển thị tổng hợp lỗi nếu có -->
        <div asp-validation-summary="ModelOnly" class="text-danger" style="color: red; margin-bottom: 15px;"></div>

        <div class="form-group" style="margin-bottom: 15px;">
            <label asp-for="Username" style="display: block; font-weight: bold; margin-bottom: 5px;"></label>
            <input asp-for="Username" class="txt_field" style="width: 100%; padding: 8px; border: 1px solid #ccc;" placeholder="Nhập tên đăng nhập..." />
            <span asp-validation-for="Username" class="text-danger" style="color: red; font-size: 12px;"></span>
        </div>

        <div class="form-group" style="margin-bottom: 15px;">
            <label asp-for="Email" style="display: block; font-weight: bold; margin-bottom: 5px;"></label>
            <input asp-for="Email" class="txt_field" style="width: 100%; padding: 8px; border: 1px solid #ccc;" placeholder="Nhập địa chỉ email..." />
            <span asp-validation-for="Email" class="text-danger" style="color: red; font-size: 12px;"></span>
        </div>

        <div class="form-group" style="margin-bottom: 15px;">
            <label asp-for="Password" style="display: block; font-weight: bold; margin-bottom: 5px;"></label>
            <input asp-for="Password" class="txt_field" type="password" style="width: 100%; padding: 8px; border: 1px solid #ccc;" placeholder="Nhập mật khẩu..." />
            <span asp-validation-for="Password" class="text-danger" style="color: red; font-size: 12px;"></span>
        </div>

        <div class="form-group" style="margin-bottom: 20px;">
            <label asp-for="ConfirmPassword" style="display: block; font-weight: bold; margin-bottom: 5px;"></label>
            <input asp-for="ConfirmPassword" class="txt_field" type="password" style="width: 100%; padding: 8px; border: 1px solid #ccc;" placeholder="Xác nhận lại mật khẩu..." />
            <span asp-validation-for="ConfirmPassword" class="text-danger" style="color: red; font-size: 12px;"></span>
        </div>

        <div class="form-group">
            <button type="submit" class="subscribebtn" style="padding: 10px 20px; background-color: #333; color: #fff; border: none; cursor: pointer; font-weight: bold;">Đăng Ký</button>
        </div>

    </form>
</div>

<div class="cleaner"></div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}